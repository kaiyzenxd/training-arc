        },
        "messageType": "block",
        "blocksUi": "={{ JSON.stringify([{ \"type\": \"header\", \"text\": { \"type\": \"plain_text\", \"text\": \"\\u26a0\\ufe0f KB Query Error\" } }, { \"type\": \"section\", \"text\": { \"type\": \"mrkdwn\", \"text\": `*Workflow:* ${$json.workflowName}\\n*Failed Node:* ${$json.errorNode}\\n*Error:* ${$json.errorMessage}\\n*Time:* ${$json.errorTimestamp}` } }, { \"type\": \"divider\" }]) }}",
        "text": "={{ '\\u26a0\\ufe0f KB Query Error: ' + $json.errorMessage }}",
        "otherOptions": {
