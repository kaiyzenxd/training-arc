            }
          ]
        },
        "options": {}
      },
      "id": "set-002",
      "name": "Extract Query Data [AUTO]",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        720,
        320
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "cond-qnotempty",
              "leftValue": "={{ $json.question }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            },
            {
              "id": "cond-qlength",
              "leftValue": "={{ $json.question.length }}",
              "rightValue": 2000,
              "operator": {
                "type": "number",
                "operation": "lte"
              }
            }
          ]
        },
        "options": {}
      },
      "id": "if-003",
      "name": "Validate Input [AUTO]",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        960,
        320
      ]
    },
    {
      "parameters": {
        "jsCode": "const WINDOW_MS = 60 * 1000;\nconst MAX_REQUESTS = 20;\nconst identifier = $input.first().json.userId || 'unknown';\nconst now = Date.now();\nif (!global.rateLimitStore) global.rateLimitStore = {};\nconst record = global.rateLimitStore[identifier] || { count: 0, windowStart: now };\nif (now - record.windowStart > WINDOW_MS) { record.count = 1; record.windowStart = now; }\nelse { record.count += 1; }\nglobal.rateLimitStore[identifier] = record;\nreturn [{ json: { ...($input.first().json), _rateLimitAllowed: record.count <= MAX_REQUESTS } }];"
      },
      "id": "code-001",
      "name": "Check Rate Limit [AUTO]",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        320
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "cond-ratelimit",
              "leftValue": "={{ $json._rateLimitAllowed }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ]
        },
        "options": {}
      },
      "id": "if-004",
      "name": "Rate Limit Gate [AUTO]",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1440,
        320
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ model: 'claude-sonnet-4-6', max_tokens: 150, messages: [{ role: 'user', content: 'Extract 3-5 specific search terms from this question. Return ONLY a JSON array with no explanation or markdown.\\nExample: [\"onboarding\", \"new hire\", \"first day\"]\\n\\nQuestion: ' + $json.question }] }) }}",
        "options": {
          "timeout": 15000
        }
      },
      "id": "http-001",
      "name": "Extract Search Keywords [AUTO]",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1680,
        320
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_WITH_YOUR_ANTHROPIC_CREDENTIAL_ID",
          "name": "Anthropic API Key"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const queryData = $('Extract Query Data [AUTO]').first().json;\nconst response = $input.first().json;\n\nlet keywords = [];\ntry {\n  const rawText = (response.content?.[0]?.text || '[]').trim();\n  const jsonText = rawText.replace(/```json\\n?/g, '').replace(/```\\n?/g, '').trim();\n  keywords = JSON.parse(jsonText);\n  if (!Array.isArray(keywords)) keywords = [];\n} catch(e) {\n  keywords = [];\n}\n\n// Build Airtable filterByFormula\nlet formula;\nif (keywords.length > 0) {\n  const conditions = keywords.map(k => `FIND(\"${k.toLowerCase().replace(/\"/g, '')}\", LOWER({Keywords}))`);\n  formula = conditions.length === 1 ? conditions[0] : `OR(${conditions.join(', ')})`;\n} else {\n  formula = '{Keywords}!=\"\"';\n}\n\nreturn [{ json: {\n  channelId: queryData.channelId,\n  userId: queryData.userId,\n  question: queryData.question,\n  keywords,\n  formula\n}}];"
      },
      "id": "code-002",
      "name": "Parse Keywords [AUTO]",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1920,
        320
      ]
    },
    {
      "parameters": {
        "operation": "search",
        "base": {
          "__rl": true,
          "mode": "id",
          "value": "appXXXXXXXXXXXXXX"
        },
        "table": {
          "__rl": true,
          "mode": "name",
          "value": "KnowledgeBase"
        },
        "filterByFormula": "={{ $json.formula }}",
        "returnAll": false,
        "limit": 5,
        "options": {}
      },
      "id": "air-001",
      "name": "Search KB Airtable [AUTO]",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.2,
      "position": [
        2160,
        320
      ],
      "alwaysOutputData": true,
      "credentials": {
        "airtableTokenApi": {
          "id": "REPLACE_WITH_YOUR_AIRTABLE_CREDENTIAL_ID",
          "name": "Airtable API"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const queryData = $('Parse Keywords [AUTO]').first().json;\nlet records = [];\ntry {\n  records = $('Search KB Airtable [AUTO]').all().filter(r => r.json && r.json.fields);\n} catch(e) {}\n\nconst hasResults = records.length > 0;\n\nreturn [{ json: {\n  channelId: queryData.channelId,\n  userId: queryData.userId,\n  question: queryData.question,\n  hasResults,\n  records: records.map(r => r.json)\n}}];"
      },
      "id": "code-003",
      "name": "Check Results Found [AUTO]",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2400,
        320
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "cond-hasresults",
              "leftValue": "={{ $json.hasResults }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        },
        "options": {}
      },
      "id": "if-005",
      "name": "Route on Results [AUTO]",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        2640,
        320
      ]
    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\nconst records = data.records.slice(0, 3);\n\nconst contextParts = records.map(r => {\n  const f = r.fields || {};\n  const content = (f.Content || '').substring(0, 2000);\n  return `**${f.Title || 'Untitled'}** (${f.DocType || 'doc'})\\nSummary: ${f.Summary || 'N/A'}\\nContent excerpt:\\n${content}`;\n});\n\nconst contextBlock = contextParts.join('\\n\\n---\\n\\n');\n\nconst systemPrompt = 'You are a helpful knowledge base assistant replying directly in Slack. Answer using ONLY the provided documents, and mention the source document title naturally in a sentence, not as a heading.\\n\\nFormat strictly for Slack mrkdwn, which is NOT standard Markdown:\\n- Use *single asterisks* for bold, never **double asterisks**\\n- Never use headers (#, ##, ###) - Slack shows them as literal characters\\n- Never use horizontal rules (---) - use a blank line between sections instead\\n- Use a plain \"-\" for bullets, no sub-headers per item\\n- Keep it tight: one short intro line, a short bulleted list only if needed, and at most one closing line. Do not restate the question or add excessive caveats.\\n\\nIf the answer is not in the documents, say so in one plain sentence.';\n\nconst userContent = `Documents:\\n${contextBlock}\\n\\nUser\\'s question: ${data.question}`;\n\nconst requestBody = {\n  model: 'claude-sonnet-4-6',\n  max_tokens: 1024,\n  system: systemPrompt,\n  messages: [{ role: 'user', content: userContent }]\n};\n\nreturn [{ json: {\n  channelId: data.channelId,\n  question: data.question,\n  requestBody: JSON.stringify(requestBody),\n  hasResults: true\n}}];"
      },
      "id": "code-004",
      "name": "Build Context [AUTO]",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2880,
        176
      ]
    },
    {
      "parameters": {
