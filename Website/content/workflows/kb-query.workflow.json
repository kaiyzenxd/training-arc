{
  "name": "KB Query",
  "nodes": [
    {
      "parameters": {
        "content": "## KB Query (v2.0 — native Slack Trigger)\nReceives Slack events natively (app_mention + message, whole workspace) from a dedicated KB Slack app. Filters out the bot's own messages → extracts search keywords via Claude → searches Airtable KnowledgeBase → synthesizes answer with source citations → replies in Slack.\n\n**Before activating:** create a separate Slack app, grab the webhook URL from the Slack Trigger node panel (not a static path), set the Signing Secret on the credential, and select your own Slack / Anthropic / Airtable credentials. See meta.notes.",
        "height": 200,
        "width": 700
      },
      "id": "note-001",
      "name": "Workflow Overview",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        240,
        80
      ]
    },
    {
      "parameters": {
        "trigger": [
          "app_mention"
        ],
        "channelId": {
          "__rl": true,
          "value": "C000000000",
          "mode": "list",
          "cachedResultName": "your-channel"
        },
        "options": {}
      },
      "id": "trig-001",
      "name": "Receive KB Query [AUTO]",
      "type": "n8n-nodes-base.slackTrigger",
      "typeVersion": 1,
      "position": [
