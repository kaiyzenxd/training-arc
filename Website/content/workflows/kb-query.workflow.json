      "parameters": {
        "jsCode": "const contextData = $('Build Context [AUTO]').first().json;\nconst response = $input.first().json;\nconst replyText = (response.content?.[0]?.text || 'Sorry, I could not generate a response.').trim();\nreturn [{ json: {\n  channelId: contextData.channelId,\n  replyText\n}}];"
      },
